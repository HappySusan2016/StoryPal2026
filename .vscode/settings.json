{
  "i18n-ally.localesPaths": [".vscode/i18n"],
  "i18n-ally.pathMatcher": "{locale}.js",
  "i18n-ally.enabledParsers": ["js"],
  "i18n-ally.enabledFrameworks": ["custom"],
  "i18n-ally.sourceLanguage": "zh",
